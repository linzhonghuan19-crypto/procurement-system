# 环境变量配置
# 复制此文件为 .env 并填写配置

# OpenAI API Key (可选，用于AI高级功能)
OPENAI_API_KEY=sk-your-key-here
OPENAI_API_BASE=https://api.openai.com/v1

# 企业微信 Webhook URL (可选，用于消息通知)
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-key

# 数据库配置 (默认使用 SQLite, 也可用 PostgreSQL)
# DATABASE_URL=postgresql://user:password@host:5432/procurement